{
  "name": "paper-browser",
  "version": "1.0.0",
  "description": "Interactive 3D HTML-in-Canvas Floating Paper Browser experience with real web proxying, HiDPI scaling, and dynamic tabs.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "bun server.ts",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "deploy": "wrangler pages deploy dist --project-name paper-browser",
    "deploy:worker": "wrangler deploy -c worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
